{
  // Editor
  "editor.formatOnSave": true,
  "editor.rulers": [{{ line_width }}],
  "editor.wordWrapColumn": {{ line_width }},

  // Newlines
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // Excludes
  "explorer.excludeGitIgnore": true,
  // The file watcher needs explicit exclusions
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/{build,dist}/**": true,
    "**/{.uv,.venv}/**": true,
    "**/{.hypothesis,.pytest_cache,htmlcov}/**": true,
    "**/{.mypy_cache,.pyright,.ruff_cache,.ty_cache}/**": true,
    "**/{.ipynb_checkpoints,.ipython,.jupyter}/**": true,
    "**/{.cache,_build,doctrees,site}/**": true
  },

  // Language-specific
  "[json]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[markdown]": {
    "editor.defaultFormatter": "dprint.dprint",
    "editor.wordWrap": "wordWrapColumn"
  },
  "[toml]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[yaml]": {
    "editor.defaultFormatter": "dprint.dprint",
    "editor.wordWrap": "bounded"
  }
}
