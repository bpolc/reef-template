{
  // Editor
  "editor.formatOnSave": true,
  "editor.rulers": [{{ line_width }}],
  "editor.wordWrapColumn": {{ line_width }},

  // Newlines
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // Excludes
  "explorer.excludeGitIgnore": true,
  // The file watcher needs explicit exclusions
  "files.watcherExclude": {
    "**/__pycache__/**": true,
    "**/{build,dist}/**": true,
    "**/{.uv,.venv}/**": true,
    "**/{.hypothesis,.pytest_cache,htmlcov}/**": true,
    "**/{.mypy_cache,.pyright,.ruff_cache,.ty_cache}/**": true,
    "**/{.ipynb_checkpoints,.ipython,.jupyter}/**": true,
    "{.cache,_build,site}/**": true,
    "docs/{_build,build}/**": true
  },

  // Python
  "python.testing.autoTestDiscoverOnSaveEnabled": true,
  "python.testing.pytestArgs": [
    "tests"
  ],
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  // Use tools from the virtual environment
  "basedpyright.importStrategy": "fromEnvironment",
  "ruff.importStrategy": "fromEnvironment",
  // Disable the Python extension's language server in favor of basedpyright
  "python.languageServer": "None",

  // Notebooks
  "notebook.formatOnSave.enabled": true,
  "notebook.codeActionsOnSave": {
    "notebook.source.fixAll": "explicit",
    "notebook.source.organizeImports": "explicit"
  },

  // Language-specific
  "[json]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[markdown]": {
    "editor.defaultFormatter": "dprint.dprint",
    "editor.wordWrap": "wordWrapColumn"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[toml]": {
    "editor.defaultFormatter": "dprint.dprint"
  },
  "[yaml]": {
    "editor.defaultFormatter": "dprint.dprint",
    "editor.wordWrap": "bounded"
  }
}
