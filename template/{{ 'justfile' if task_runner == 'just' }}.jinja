# 📄 https://just.systems/man/en/recipes.html

set minimum-version := '1.58.0'
set default-list
set positional-arguments

# Install dependencies and Git hooks
[group('setup')]
setup:
    uv sync
    uv run --no-sync prek install --prepare-hooks

# Run all repository hooks
[group('quality')]
hooks *args:
    uv run prek run --all-files --hook-stage manual "$@"

# Format project files
[group('quality')]
format:
    just --fmt
    uv run dprint fmt .
    uv run ruff format --force-exclude

# Lint Python code
[group('quality')]
lint *args:
    uv run ruff check src tests "$@"

# Type-check Python code
[group('quality')]
typecheck:
    uv run basedpyright

# Run all required checks
[group('quality')]
check:
    just --fmt --check
    uv run dprint check .
    uv run ruff format --check --force-exclude
    just lint
    just typecheck
    just test

# Run tests
[group('testing')]
test *args:
    uv run pytest "$@"

# Run tests with branch coverage
[group('testing')]
coverage *args:
    @just test \
        --cov \
        --cov-context=test \
        --cov-report=term \
        --cov-report=html \
        "$@"

# Remove generated files and caches (preserve virtual environment)
[group('maintenance')]
clean:
    git clean -fdX \
        -e '!*' \
        -e '.cache/' \
        -e '.coverage.*' \
        -e '.coverage' \
        -e '.hypothesis/' \
        -e '.mypy_cache/' \
        -e '.pyright/' \
        -e '.pytest_cache/' \
        -e '.ruff_cache/' \
        -e '.ty_cache/' \
        -e '/.uv/' \
        -e '_build/' \
        -e '/build/' \
        -e '/dist/' \
        -e 'doctrees/' \
        -e '/htmlcov/' \
        -e 'site/' \
        -e '**/__pycache__/' \
        -e '!/.venv/**'
