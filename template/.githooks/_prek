#!/bin/sh
set -eu

hook_type=$1
shift

cd "$(git rev-parse --show-toplevel)"
root=$PWD
# Add both POSIX and Windows venv directories
venv_path="$root/.venv/bin:$root/.venv/Scripts"

if ! prek=$(PATH="$venv_path" command -v prek); then
    echo "error: prek not found in .venv; run uv sync" >&2
    exit 1
fi

PATH="$venv_path:$PATH"
export PATH

exec "$prek" hook-impl \
    --hook-type "$hook_type" \
    --skip-on-missing-config \
    -- "$@"
