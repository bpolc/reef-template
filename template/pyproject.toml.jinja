# 📄 https://packaging.python.org/en/latest/guides/writing-pyproject-toml/

[project]
name = {{ name | tojson }}
version = "0.1.0"
import-names = [{{ module | tojson }}]
description = {{ description | to_json(ensure_ascii=False) | replace('\u007f', '\\u007f') }}
readme = "README.md"
{% if licenses %}
license = {{ licenses | sort | join(' OR ') | tojson }}
license-files = ["LICENSE-*"]
{% endif %}
{% if author_name or author_email %}
authors = [
    { {% if author_name %}name = {{ author_name | to_json(ensure_ascii=False) | replace('\u007f', '\\u007f') }}{% if author_email %}, {% endif %}{% endif %}{% if author_email %}email = {{ author_email | to_json(ensure_ascii=False) | replace('\u007f', '\\u007f') }}{% endif %} },
]
{% endif %}
requires-python = ">={{ min_python }}"
classifiers = [
    "Operating System :: OS Independent",
    {% if not licenses %}
    "Private :: Do Not Upload",
    {% endif %}
    "Programming Language :: Python :: 3",
    {% for version in python_versions[python_versions.index(min_python):] %}
    "Programming Language :: Python :: {{ version }}",
    {% endfor %}
    "Typing :: Typed",
]

[dependency-groups]
dev = [
    { include-group = "lint" },
    { include-group = "test" },
]
lint = [
    "basedpyright>=1.40",
    "dprint-py>=0.63.0",
    "prek>=0.5.5",
    "ruff>=0.16.5",
]
test = [
    "pytest>=9.0",
    "pytest-cov>=7",
    "pytest-randomly>=5",
    "pytest-timeout>=2.4",
    "pytest-xdist>=3.8",
]

[build-system]
requires = ["uv_build>=0.13.1,<0.14"]
build-backend = "uv_build"

# 📄 https://docs.astral.sh/uv/concepts/build-backend/#configuration
[tool.uv.build-backend]
module-name = {{ module | tojson }}

# TEST #

# 📄 https://docs.pytest.org/en/latest/reference/reference.html#configuration-options
[tool.pytest]
minversion = "9.0"
addopts = [
    "-ra", # summary of all non-passed tests
    "--import-mode=importlib",
    "-n4", # number of workers (processes)
    "--ignore-glob=**/htmlcov",
]
strict = true
# Test timeout (sec), override with: @pytest.mark.timeout(n)
timeout = "60"
testpaths = ["tests"]
filterwarnings = [
    "error::DeprecationWarning",
    "error::FutureWarning",
    "error::PendingDeprecationWarning",
]

# 📄 https://coverage.readthedocs.io/en/latest/config.html#run
[tool.coverage.run]
branch = true
source = ["src"]

# 📄 https://coverage.readthedocs.io/en/latest/config.html#report
[tool.coverage.report]
show_missing = true
skip_covered = true
# To exclude code from line/branch coverage, use:
#   # pragma: no cover
#   # pragma: no branch
exclude_also = [
    '(typing\.)?assert_never\(',
    '@(typing\.)?overload',
    '@(abc\.)?abstractmethod',
    'class .*\bProtocol\):',
    'def __repr__\b',
    "if __name__ == .__main__.:",
    "if 0:",
    'raise AssertionError\b',
    'raise NotImplementedError\b',
]

# TYPE CHECK #

# 📄 https://docs.basedpyright.com/latest/configuration/config-files/
[tool.basedpyright]
include = ["src", "tests"]
# Hidden directories, __pycache__, and virtual environments are excluded by default.
exclude = [
    "_build",
    "build",
    "dist",
    "docs/_build",
    "docs/build",
    "htmlcov",
    "site",
]
pythonVersion = "{{ min_python }}"
typeCheckingMode = "recommended"
allowedUntypedLibraries = []

# Allow `Any`
reportAny = "hint"
reportExplicitAny = "hint"

# 📄 https://docs.basedpyright.com/latest/configuration/config-files/#execution-environment-options
[[tool.basedpyright.executionEnvironments]]
root = "tests"
extraPaths = ["."]

# Some tests intentionally make invalid calls/accesses
reportArgumentType = "hint"
reportAttributeAccessIssue = "hint"
reportCallIssue = "hint"
reportOptionalCall = "hint"
reportOptionalMemberAccess = "hint"

# Tests may access internals
reportPrivateImportUsage = false
reportPrivateUsage = false

# Fixtures and mocks are often dynamic
reportUnknownArgumentType = false
reportUnknownLambdaType = false
reportUnknownMemberType = false
reportUnknownVariableType = false

# Common test patterns
reportUnusedCallResult = false
reportUnusedClass = false

# LINT + FORMAT #

# 📄 https://docs.astral.sh/ruff/settings/#top-level
[tool.ruff]
line-length = {{ line_width }}

# 📄 https://docs.astral.sh/ruff/settings/#lint
[tool.ruff.lint]
preview = true
select = [
    "correctness",
    "suspicious",
    "complexity",
    "performance",
    "style",
]

[tool.ruff.lint.per-file-ignores]
# Rules with BasedPyright equivalents (that Ruff can't safely autofix)
"{src,tests}/**/*.{py,pyi}" = [
    "ANN001", # reportMissingParameterType
    "ANN002", # reportMissingParameterType
    "ANN003", # reportMissingParameterType
    "ARG001", # reportUnusedParameter
    "ARG002", # reportUnusedParameter
    "ARG003", # reportUnusedParameter
    "ARG004", # reportUnusedParameter
    "ARG005", # reportUnusedParameter
    "B015", # reportUnusedExpression
    "B018", # reportUnusedExpression
    "F631", # reportAssertAlwaysTrue
    "F821", # reportUndefinedVariable
    "F822", # reportUnsupportedDunderAll
    "N804", # reportSelfClsParameterName
    "N805", # reportSelfClsParameterName
    "PLE0604", # reportUnsupportedDunderAll
    "PLE0605", # reportUnsupportedDunderAll
    "PYI056", # reportUnsupportedDunderAll
]

# Many rules are already adapted for notebook cells
"**/*.ipynb" = [
    "T20", # print/pprint
]

# 📄 https://docs.astral.sh/ruff/settings/#format
[tool.ruff.format]
docstring-code-format = true
line-ending = "lf"
