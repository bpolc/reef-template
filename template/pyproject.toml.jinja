# 📄 https://packaging.python.org/en/latest/guides/writing-pyproject-toml/

[project]
name = "{{ name }}"
import-names = ["{{ module }}"]
version = "0.1.0"
description = "{{ description }}"
{% if author_name or author_email %}
authors = [
    { {% if author_name %}name = "{{ author_name }}"{% if author_email %}, {% endif %}{% endif %}{% if author_email %}email = "{{ author_email }}"{% endif %} },
]
{% endif %}
readme = "README.md"
requires-python = ">={{ min_python }}"
classifiers = [
    "Programming Language :: Python :: 3",
    {% for version in python_versions[python_versions.index(min_python):] %}
    "Programming Language :: Python :: {{ version }}",
    {% endfor %}
]

[dependency-groups]
dev = [
    { include-group = "lint" },
    { include-group = "test" },
]
lint = [
    "dprint-py>=0.63.0",
    "prek>=0.5.5",
    "ruff>=0.16.5",
]
test = [
    "pytest>=9.0",
    "pytest-cov>=7",
    "pytest-randomly>=5",
    "pytest-timeout>=2.4",
    "pytest-xdist>=3.8",
]

[build-system]
requires = ["uv_build>=0.12.23,<0.13"]
build-backend = "uv_build"

# TEST #

# 📄 https://docs.pytest.org/en/latest/reference/reference.html#configuration-options
[tool.pytest]
minversion = "9.0"
addopts = [
    "-ra", # summary of all non-passed tests
    "--import-mode=importlib",
]
strict = true
# Test timeout (sec), override with: @pytest.mark.timeout(n)
timeout = 60
testpaths = ["tests"]
filterwarnings = [
    "error::DeprecationWarning",
    "error::FutureWarning",
    "error::PendingDeprecationWarning",
]

# 📄 https://coverage.readthedocs.io/en/latest/config.html#run
[tool.coverage.run]
branch = true
source = ["src"]

# 📄 https://coverage.readthedocs.io/en/latest/config.html#report
[tool.coverage.report]
show_missing = true
skip_covered = true
# To exclude code from line/branch coverage, use:
#   # pragma: no cover
#   # pragma: no branch
exclude_also = [
    '(typing\.)?assert_never\(',
    '@(typing\.)?overload',
    '@(abc\.)?abstractmethod',
    'class .*\bProtocol\):',
    'def __repr__\b',
    'if __name__ == .__main__.:',
    'if 0:',
    'raise AssertionError\b',
    'raise NotImplementedError\b',
]

# LINT + FORMAT #

# 📄 https://docs.astral.sh/ruff/settings/#top-level
[tool.ruff]
line-length = {{ line_width }}

# 📄 https://docs.astral.sh/ruff/settings/#lint
[tool.ruff.lint]
preview = true
select = [
    "correctness",
    "suspicious",
    "complexity",
    "performance",
    "style",
]

[tool.ruff.lint.per-file-ignores]
# Many rules are already adapted for notebook cells
"**/*.ipynb" = [
    "T20", # print/pprint
]

# 📄 https://docs.astral.sh/ruff/settings/#format
[tool.ruff.format]
docstring-code-format = true
line-ending = "lf"
