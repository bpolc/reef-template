# 📄 https://packaging.python.org/en/latest/guides/writing-pyproject-toml/

[project]
name = "{{ name }}"
import-names = ["{{ module }}"]
version = "0.1.0"
description = "{{ description }}"
readme = "README.md"
requires-python = ">={{ min_python }}"

[dependency-groups]
dev = [
    { include-group = "lint" },
]
lint = [
    "prek>=0.5.5",
]

[build-system]
requires = ["uv_build>=0.12.23,<0.13"]
build-backend = "uv_build"
