# 📄 https://editorconfig.org/
# Keep this config aligned with dprint.jsonc and pyproject.toml

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
max_line_length = {{ line_width }}
trim_trailing_whitespace = true

[*.json]
indent_size = 2

[*.jsonc]
indent_size = 2
